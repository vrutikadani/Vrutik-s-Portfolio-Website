---
// The Pivot mark: a compass ring with a needle that can turn.
// Used as the wordmark glyph and as the Pivot guide's body.
interface Props { size?: number; class?: string; angle?: number; label?: string }
const { size = 28, class: className = '', angle = -35, label } = Astro.props;
---
<svg
  class:list={['pivot-glyph', className]}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  style={`--needle:${angle}deg`}
>
  <circle cx="16" cy="16" r="13.5" fill="none" stroke="currentColor" stroke-width="1.5" />
  <path d="M16 1.5v3.2M30.5 16h-3.2M16 30.5v-3.2M1.5 16h3.2" stroke="currentColor" stroke-width="1.5" />
  <g class="pivot-needle">
    <path d="M16 6.5 19 16h-6z" fill="var(--pivot-needle, currentColor)" />
    <path d="M16 25.5 13 16h6z" fill="currentColor" opacity=".35" />
  </g>
  <circle cx="16" cy="16" r="1.8" fill="var(--surface, #fff)" stroke="currentColor" stroke-width="1.2" />
</svg>
<style>
  .pivot-needle {
    transform-origin: 16px 16px;
    transform: rotate(var(--needle));
    transition: transform 420ms cubic-bezier(0.3, 1.4, 0.5, 1);
  }
</style>
